<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>MacMonitor</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <volume-check>
        <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
    </volume-check>
    <domains enable_anywhere="false" enable_localSystem="true" enable_currentUserHome="false"/>

    <choices-outline>
        <line choice="default"><line choice="com.rafetsapanci.MacMonitor.pkg"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.rafetsapanci.MacMonitor.pkg" visible="false"><pkg-ref id="com.rafetsapanci.MacMonitor.pkg"/></choice>
    <pkg-ref id="com.rafetsapanci.MacMonitor.pkg" version="@VERSION@" onConclusion="none">MacMonitor-component.pkg</pkg-ref>
</installer-gui-script>
